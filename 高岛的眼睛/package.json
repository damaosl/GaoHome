{
  "name": "takashima-eyes",
  "productName": "高岛的眼睛",
  "version": "0.1.0",
  "description": "高岛的眼睛 — 极简假反馈拦截工具，拦截应用/接口/插件的反馈并按方向注入自定义假反馈",
  "type": "module",
  "bin": {
    "takashima-eyes": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "http-proxy": "^1.18.1",
    "minimatch": "^9.0.5",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
